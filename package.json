{
  "name": "battlecaos-gateway",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.0",
    "kafkajs": "^2.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "nodemon": "^3.1.14",
    "vitest": "^4.1.9"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "include": ["src/domain/**"],
      "reporter": ["text", "html"]
    }
  }
}
