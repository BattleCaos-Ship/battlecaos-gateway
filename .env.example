REDIS_URL=redis://localhost:6379
# Respaldo opcional: si se define, el cliente entra en modo RESILIENTE (doble escritura al
# primario REDIS_URL y a este respaldo; lee del primario y cae al respaldo si el primario falla).
# Ej. Upstash primario + Redis local de respaldo:  REDIS_FALLBACK_URL=redis://localhost:6379
# REDIS_FALLBACK_URL=
GATEWAY_PORT=3000
JWT_SECRET=cambiar_en_produccion_minimo_32_caracteres
CLIENT_ORIGIN=http://localhost:5173

# Kafka (Upstash o local Docker)
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=battlecaos-gateway
# KAFKA_USERNAME=   # solo Upstash — dejar vacío en local
# KAFKA_PASSWORD=   # solo Upstash — dejar vacío en local
